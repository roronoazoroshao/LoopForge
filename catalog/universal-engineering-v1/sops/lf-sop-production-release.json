{
  "id": "lf-sop-production-release",
  "name": "Production Release",
  "version": 1,
  "revision": 1,
  "status": "draft",
  "description": "SOP Production Release. Dùng đúng role, kiểm chứng artifacts và human gate; không tự deploy/merge.",
  "sandboxProfileId": "generic-docker",
  "tags": [
    "lf-universal-v1",
    "sop"
  ],
  "nodes": [
    {
      "id": "engineering-lead-plan",
      "name": "Engineering Lead",
      "type": "agent",
      "agentId": "lf-role-engineering-lead",
      "maxAttempts": 2,
      "metricStage": "clarification",
      "position": {
        "x": 100,
        "y": 150
      },
      "artifactOutputs": [
        {
          "name": "Kế hoạch kỹ thuật và phân rã",
          "path": "lf-engineering-plan.md",
          "mediaType": "text/markdown",
          "required": true
        }
      ]
    },
    {
      "id": "approve-plan",
      "name": "Phê duyệt phạm vi trước thay đổi",
      "type": "approval",
      "taskPrompt": "Người phê duyệt kiểm tra yêu cầu, phương án, quyền, rủi ro, tiêu chí nghiệm thu và rollback; reject nếu thiếu. Không tự triển khai production hoặc thay đổi dữ liệu thật.",
      "maxAttempts": 1,
      "maxReworks": 2,
      "rejectTo": "engineering-lead-plan",
      "position": {
        "x": 345,
        "y": 150
      }
    },
    {
      "id": "devops-engineer",
      "name": "DevOps Engineer",
      "type": "agent",
      "agentId": "lf-role-devops-engineer",
      "maxAttempts": 2,
      "metricStage": "development",
      "position": {
        "x": 590,
        "y": 150
      },
      "artifactOutputs": [
        {
          "name": "CI/CD, build và triển khai",
          "path": "lf-devops-report.md",
          "mediaType": "text/markdown",
          "required": true
        }
      ]
    },
    {
      "id": "sre-engineer",
      "name": "SRE Engineer",
      "type": "agent",
      "agentId": "lf-role-sre-engineer",
      "maxAttempts": 2,
      "metricStage": "development",
      "position": {
        "x": 835,
        "y": 150
      },
      "artifactOutputs": [
        {
          "name": "Reliability và incident",
          "path": "lf-sre-report.md",
          "mediaType": "text/markdown",
          "required": true
        }
      ]
    },
    {
      "id": "security-auditor",
      "name": "Security Auditor",
      "type": "agent",
      "agentId": "lf-role-security-auditor",
      "maxAttempts": 2,
      "metricStage": "testing",
      "position": {
        "x": 1080,
        "y": 150
      },
      "artifactOutputs": [
        {
          "name": "Audit độc lập",
          "path": "lf-security-review.md",
          "mediaType": "text/markdown",
          "required": true
        }
      ]
    },
    {
      "id": "release-manager",
      "name": "Release Manager",
      "type": "agent",
      "agentId": "lf-role-release-manager",
      "maxAttempts": 2,
      "metricStage": "development",
      "position": {
        "x": 1325,
        "y": 150
      },
      "artifactOutputs": [
        {
          "name": "Release readiness",
          "path": "lf-release-report.md",
          "mediaType": "text/markdown",
          "required": true
        }
      ]
    },
    {
      "id": "accept",
      "name": "Nghiệm thu độc lập",
      "type": "approval",
      "taskPrompt": "Kiểm tra artifacts đúng revision, findings và bằng chứng thực tế. Chỉ chấp thuận khi tiêu chí đạt, không có blocker và quyền đúng phạm vi; nếu không, reject kèm finding. Không chấp thuận tự động.",
      "maxAttempts": 1,
      "maxReworks": 2,
      "rejectTo": "devops-engineer",
      "position": {
        "x": 1570,
        "y": 150
      }
    }
