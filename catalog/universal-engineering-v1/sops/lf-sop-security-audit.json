        }
      ]
    },
    {
      "id": "security-auditor",
      "name": "Security Auditor",
      "type": "agent",
      "agentId": "lf-role-security-auditor",
      "maxAttempts": 2,
      "metricStage": "testing",
      "position": {
        "x": 345,
        "y": 150
      },
      "artifactOutputs": [
        {
          "name": "Audit độc lập",
          "path": "lf-security-review.md",
